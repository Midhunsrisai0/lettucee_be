    {
      "name": "Users",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"countryCode\": \"+91\",\n  \"phoneNumber\": \"9000000000\",\n  \"username\": \"newuser\",\n  \"password\": \"StrongPass123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "register"]
            },
            "description": "Registers a user in PENDING status."
          },
          "response": []
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json?.data?.token) pm.collectionVariables.set('authToken', json.data.token);",
                  "  if (json?.data?.user?.id) pm.collectionVariables.set('approveeUserId', json.data.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"password\": \"StrongPass123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "login"]
            },
            "description": "Logs in a user. On 200, stores token to collection variable authToken."
          },
          "response": []
        },
        {
          "name": "Who Am I",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/whoami",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "whoami"]
            },
            "description": "Returns user info from JWT payload."
          },
          "response": []
        },
        {
          "name": "List Approved Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users"]
            },
            "description": "Fetches approved users."
          },
          "response": []
        },
        {
          "name": "Approve Pending User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{approveeUserId}}\",\n  \"superAccess\": false,\n  \"superAccessReason\": \"Temporary elevated access not required\",\n  \"comments\": \"Approved by admin after verification\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/approve-pending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "approve-pending"]
            },
            "description": "Approves a pending user. Requires admin token."
          },
          "response": []
        },
        {
          "name": "List Pending Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/pending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "pending"]
            },
            "description": "Lists all pending users. Admin access required."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://lettucee-be.mittulabs.workers.dev"
