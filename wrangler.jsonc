{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lettucee-be",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-28",
  "observability": {
    "enabled": true,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CALL_ROOM",
        "class_name": "CallRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CallRoom"],
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lettucee-db",
      "database_id": "1965b5cc-6556-4818-9daf-795243781fae",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "APPROVAL_QUEUE",
        "queue": "lettucee-approval-jobs",
      },
      {
        "binding": "HEALTH_CHECK_QUEUE",
        "queue": "health-check-jobs",
      },
      {
        "binding": "SYNC_CONTACTS_QUEUE",
        "queue": "sync-contacts-jobs",
      },
    ],
    "consumers": [
      {
        "queue": "lettucee-approval-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_concurrency": 1,
      },
      {
        "queue": "health-check-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_concurrency": 1,
      },
      {
        "queue": "sync-contacts-jobs",
        "max_batch_size": 5,
        "max_batch_timeout": 30,
        "max_concurrency": 1,
      },
    ],
  },
  "vars": {
    "APP_NAME": "lettucee-be",
    "APP_ENV": "development",
  },
}
